ObjC.import('AppKit');
ObjC.import('CoreGraphics');

const MAX_SCROLL_AT_AMOUNT = 50000;
const MAX_SCROLL_EVENT_AMOUNT = 10;
const DEFAULT_SCROLL_AT_PIXEL_AMOUNT = 30;

function safe(fn, fallback) {
  try {
    const value = fn();
    return value === undefined || value === null ? fallback : value;
  } catch (_) {
    return fallback;
  }
}

function fail(type, message) {
  const error = new Error(message);
  error.errorType = type;
  throw error;
}

function systemEvents() {
  const app = Application('System Events');
  app.includeStandardAdditions = true;
  return app;
}

function visibleProcesses(se) {
  return se.applicationProcesses().filter((proc) => !Boolean(safe(() => proc.backgroundOnly(), true)));
}

function serverWindowRows() {
  const rows = safe(() => {
    const reference = $.CGWindowListCopyWindowInfo(
      $.kCGWindowListOptionAll,
      $.kCGNullWindowID,
    );
    const rows = ObjC.deepUnwrap(ObjC.castRefToObject(reference));
    if (!Array.isArray(rows)) return [];
    const seen = new Set();
    return rows.filter((row) => {
      const number = Number(row.kCGWindowNumber || 0);
      const pid = Number(row.kCGWindowOwnerPID || 0);
      if (!(number > 0) || !(pid > 0) || Number(row.kCGWindowLayer || 0) !== 0) return false;
      if (seen.has(number)) return false;
      seen.add(number);
      // WindowServer also tracks chrome surfaces (menu-bar strips, toolbars,
      // web-process backing stores) at layer 0; only real windows are useful
      // as App Use targets. The 60x60 cutoff is a heuristic: it drops the
      // ~30/33px menu-bar strips and other chrome while keeping small 54x54
      // floating palettes; the real criterion is "a visible window that can
      // carry clicks".
      const bounds = row.kCGWindowBounds || {};
      if (Number(bounds.Width || 0) < 60 || Number(bounds.Height || 0) < 60) return false;
      return true;
    });
  }, []);
  // CGWindowList's OptionAll rows carry no minimized flag; one extra
  // OnScreenOnly query (millisecond-scale) yields the visible window numbers,
  // so a row absent from that set is reported as minimized. This also flags
  // windows on other Spaces and hidden windows as minimized — they are equally
  // invisible, so hiding the pointer for them is correct.
  rows.onscreenWindowNumbers = safe(() => {
    const reference = $.CGWindowListCopyWindowInfo(
      $.kCGWindowListOptionOnScreenOnly,
      $.kCGNullWindowID,
    );
    const onScreen = ObjC.deepUnwrap(ObjC.castRefToObject(reference));
    if (!Array.isArray(onScreen)) return new Set();
    return new Set(onScreen.map((row) => Number(row.kCGWindowNumber || 0)));
  }, new Set());
  return rows;
}

function runningAppInfo() {
  // In the JXA ObjC bridge, NSString-typed properties are exposed as
  // non-callable proxies (typeof reports "function" but invoking throws);
  // unwrap the property access directly.
  const readString = (app, property) => safe(() => String(ObjC.unwrap(app[property]) || ''), '');
  const info = new Map();
  const apps = $.NSWorkspace.sharedWorkspace.runningApplications;
  for (let index = 0; index < apps.count; index += 1) {
    const app = apps.objectAtIndex(index);
    const pid = Number(app.processIdentifier);
    if (!(pid > 0)) continue;
    info.set(pid, {
      name: readString(app, 'localizedName'),
      applicationId: readString(app, 'bundleIdentifier'),
      // NSApplicationActivationPolicyRegular (0) mirrors the old System
      // Events backgroundOnly filter: Dock-less helpers (extension UIs,
      // loginwindow) are not useful App Use targets.
      policy: Number(app.activationPolicy),
    });
  }
  return info;
}

function windowIdentifier(win, index) {
  const nativeId = safe(() => win.id(), '');
  return nativeId === '' ? `index:${index}` : String(nativeId);
}

function windowBounds(win) {
  const position = safe(() => win.position(), null);
  const size = safe(() => win.size(), null);
  if (!Array.isArray(position) || !Array.isArray(size)) return null;
  return {
    x: Number(position[0] || 0),
    y: Number(position[1] || 0),
    width: Number(size[0] || 0),
    height: Number(size[1] || 0),
  };
}

function listTargets(payload) {
  // AppKit + WindowServer enumeration only: no System Events accessibility
  // reads, so listing stays fast (~200ms) and works without accessibility
  // permission. Window names are only disclosed by CGWindowList when the
  // caller holds Screen Recording permission; the semantic snapshot re-reads
  // titles from the accessibility tree once a target is selected.
  const frontmostPid = Number($.NSWorkspace.sharedWorkspace.frontmostApplication.processIdentifier);
  const excludePid = Number(payload.excludePid || 0);
  const excludedApplicationIds = new Set((payload.excludeApplicationIds || []).map((value) => String(value).toLowerCase()));
  const excludedAppNames = new Set((payload.excludeAppNames || []).map((value) => String(value).toLowerCase()));
  const appInfo = runningAppInfo();
  const rows = serverWindowRows();
  const onscreenWindowNumbers = rows.onscreenWindowNumbers;
  const targets = [];
  const perPidIndexes = new Map();
  for (const row of rows) {
    const pid = Number(row.kCGWindowOwnerPID || 0);
    if (pid === excludePid) continue;
    const info = appInfo.get(pid);
    if (!info || Number(info.policy) !== 0) continue;
    const appName = String(info.name || row.kCGWindowOwnerName || '');
    const applicationId = String(info.applicationId || '');
    if (excludedApplicationIds.has(applicationId.toLowerCase()) || excludedAppNames.has(appName.toLowerCase())) continue;
    const bounds = row.kCGWindowBounds || {};
    const index = perPidIndexes.get(pid) || 0;
    perPidIndexes.set(pid, index + 1);
    targets.push({
      platform: 'darwin',
      pid,
      processStartTime: '',
      appName,
      applicationId,
      // WindowServer window number: process-directed mouse events need it to
      // route the NSEvent into the correct background NSWindow.
      windowId: String(row.kCGWindowNumber || 0),
      windowIndex: index,
      // CGWindowList only discloses titles with Screen Recording permission;
      // an empty title without it is expected, and the semantic snapshot
      // re-reads AX titles once the target is connected.
      windowTitle: String(row.kCGWindowName || ''),
      foreground: pid === frontmostPid,
      // CGWindowList's OptionAll rows carry no minimized flag; derive it from
      // the extra OnScreenOnly query: windows absent from the on-screen set
      // (minimized, on another Space, or hidden) are reported as minimized.
      minimized: !onscreenWindowNumbers.has(Number(row.kCGWindowNumber || 0)),
      bounds: {
        x: Number(bounds.X || 0),
        y: Number(bounds.Y || 0),
        width: Number(bounds.Width || 0),
        height: Number(bounds.Height || 0),
      },
    });
  }
  return { ok: true, targets };
}

function boundsMatch(axBounds, targetBounds, tolerance) {
  if (!axBounds || !targetBounds) return false;
  const width = Number(targetBounds.width || 0);
  const height = Number(targetBounds.height || 0);
  if (!(width > 0) || !(height > 0) || !(axBounds.width > 0) || !(axBounds.height > 0)) return false;
  return Math.abs(axBounds.x - Number(targetBounds.x || 0)) <= tolerance
    && Math.abs(axBounds.y - Number(targetBounds.y || 0)) <= tolerance
    && Math.abs(axBounds.width - width) <= tolerance
    && Math.abs(axBounds.height - height) <= tolerance;
}

function resolveTarget(target) {
  const se = systemEvents();
  const pid = Number(target.pid || 0);
  const processes = visibleProcesses(se);
  const proc = processes.find((candidate) => Number(safe(() => candidate.unixId(), 0)) === pid);
  if (!proc) throw new Error('Target application process is no longer available.');
  const windows = proc.windows();
  let win = null;
  // Listed windowId is a WindowServer number, which lives in a different
  // namespace than AX window ids, so prefer a bounds match first.
  if (target.bounds) {
    const candidates = windows.filter((candidate) => boundsMatch(windowBounds(candidate), target.bounds, 8));
    if (candidates.length === 1) {
      win = candidates[0];
    } else if (candidates.length > 1) {
      // Several windows share the same bounds (e.g. stacked windows): prefer
      // the one at the listed windowIndex position in the AX array, falling
      // back to the first candidate.
      const wantedIndex = Number.isInteger(Number(target.windowIndex)) ? Number(target.windowIndex) : -1;
      win = candidates.find((candidate) => windows.indexOf(candidate) === wantedIndex) || candidates[0];
    }
  }
  if (!win) {
    // No bounds match (the window moved or was resized): fall back to a strict
    // window-id match. The WindowServer id namespace differs from AX ids, so a
    // hit is trustworthy, but never blindly index the AX window array with the
    // listing's cross-namespace index.
    const wantedId = String(target.windowId || '');
    for (let index = 0; index < windows.length; index += 1) {
      if (windowIdentifier(windows[index], index) === wantedId) {
        win = windows[index];
        break;
      }
    }
    if (!win) {
      throw new Error('Target application window is no longer available: the window moved or resized since listing.');
    }
  }
  const windowIndex = windows.indexOf(win);
  return { se, proc, win, windowIndex };
}

function safariTab(target) {
  if (String(target.applicationId || '') !== 'com.apple.Safari') fail('unsupported_action', 'This browser capability is only available for Safari.');
  const safari = Application('Safari');
  if (!safari.running()) fail('stale_session', 'Safari is no longer running.');
  const windows = safari.windows();
  let picked = null;
  const wantedId = String(target.windowId || '');
  let idMatches = [];
  if (wantedId && wantedId !== '0') {
    // On Safari versions where the AppleScript id maps to the WindowServer
    // id, retain that strong signal to disambiguate stacked windows or a
    // window that moved after it was listed.
    idMatches = windows.filter(
      (candidate) => String(safe(() => candidate.id(), '')) === wantedId,
    );
  }

  const targetBounds = target.bounds || null;
  const hasBounds = targetBounds
    && Number(targetBounds.width || 0) > 0
    && Number(targetBounds.height || 0) > 0;
  if (hasBounds) {
    // AppleScript windows() ordering is independent of CGWindowList ordering.
    // Match the complete rectangle instead of one dimension; equal-height
    // windows are common. If stacked windows remain ambiguous, fail safely
    // rather than navigating or reloading an arbitrary Safari window.
    const boundsCandidates = windows.filter((candidate) => {
      const raw = safe(() => candidate.bounds(), null);
      let normalized = null;
      if (Array.isArray(raw) && raw.length >= 4) {
        normalized = {
          x: Number(raw[0] || 0),
          y: Number(raw[1] || 0),
          width: Number(raw[2] || 0) - Number(raw[0] || 0),
          height: Number(raw[3] || 0) - Number(raw[1] || 0),
        };
      } else if (raw && typeof raw === 'object') {
        const x = Number(raw.x !== undefined ? raw.x : raw.left || 0);
        const y = Number(raw.y !== undefined ? raw.y : raw.top || 0);
        normalized = {
          x,
          y,
          width: Number(raw.width || 0) > 0
            ? Number(raw.width || 0)
            : Number(raw.right || 0) - x,
          height: Number(raw.height || 0) > 0
            ? Number(raw.height || 0)
            : Number(raw.bottom || 0) - y,
        };
      }
      return boundsMatch(normalized, targetBounds, 8);
    });
    if (boundsCandidates.length === 1) {
      if (idMatches.length === 1 && idMatches[0] !== boundsCandidates[0]) {
        fail('stale_session', 'The connected Safari window identity no longer matches its bounds.');
      }
      picked = boundsCandidates[0];
    }
    else if (boundsCandidates.length > 1) {
      const identified = boundsCandidates.filter(
        (candidate) => idMatches.indexOf(candidate) >= 0,
      );
      if (identified.length === 1) picked = identified[0];
      else fail('stale_session', 'The connected Safari window cannot be identified unambiguously.');
    } else if (idMatches.length === 1) {
      picked = idMatches[0];
    } else {
      fail('stale_session', 'The connected Safari window is no longer available.');
    }
  }

  if (!picked && !hasBounds) {
    const index = Math.max(0, Number(target.windowIndex || 0));
    if (index >= windows.length) fail('stale_session', 'The connected Safari window is no longer available.');
    picked = windows[index];
  }
  if (!picked) fail('stale_session', 'The connected Safari window is no longer available.');
  return { safari, window: picked, tab: picked.currentTab };
}

function safariState(target) {
  const resolved = safariTab(target);
  return {
    url: String(safe(() => resolved.tab.url(), '')),
    title: String(safe(() => resolved.tab.name(), '')),
    loading: Boolean(safe(() => resolved.tab.loading(), false)),
    foreground: Boolean(safe(() => resolved.safari.frontmost(), false)),
    windowIndex: Math.max(0, Number(target.windowIndex || 0)),
  };
}

function normalizeUrl(value) {
  const url = String(value || '').trim();
  if (!url) fail('invalid_arguments', 'navigate requires a non-empty URL.');
  if (!/^[a-z][a-z0-9+.-]*:/i.test(url)) return `https://${url}`;
  return url;
}

function performSafari(target, capability, parameters) {
  const resolved = safariTab(target);
  if (capability === 'browser_state') {
    const state = safariState(target);
    return { ok: true, verified: true, skipSnapshot: true, summary: `Safari is at ${state.url || '(empty URL)'}.`, verification: state, diagnostics: { method: 'Safari Apple Events', backgroundSafe: true }, nextValidActions: ['call:navigate', 'call:reload', 'call:visual_describe', 'disconnect'] };
  }
  if (capability === 'navigate') {
    const requestedUrl = normalizeUrl(parameters.url);
    resolved.tab.url = requestedUrl;
    delaySeconds(0.15);
    const state = safariState(target);
    const accepted = state.url === requestedUrl || state.url.startsWith(`${requestedUrl}/`) || requestedUrl.startsWith(`${state.url}/`);
    if (!accepted) fail('verification_failed', `Safari did not accept the requested URL. Current URL: ${state.url || '(empty)'}.`);
    return { ok: true, verified: true, skipSnapshot: true, summary: `Navigated Safari to ${requestedUrl}.`, verification: state, diagnostics: { method: 'Safari currentTab.url', backgroundSafe: true, requestedUrl }, nextValidActions: ['call:browser_state', 'call:visual_describe', 'call:reload', 'disconnect'] };
  }
  if (capability === 'reload') resolved.tab.url = String(safe(() => resolved.tab.url(), ''));
  else fail('unsupported_action', `Unsupported Safari capability: ${capability}`);
  delaySeconds(0.15);
  return { ok: true, verified: true, skipSnapshot: true, summary: `Performed Safari ${capability}.`, verification: safariState(target), diagnostics: { method: 'Safari Apple Events', backgroundSafe: true }, nextValidActions: ['call:browser_state', 'call:visual_describe', 'call:navigate', 'disconnect'] };
}

function delaySeconds(seconds) {
  $.NSThread.sleepForTimeInterval(Number(seconds || 0));
}

function finiteNumber(value, name) {
  const number = Number(value);
  if (!Number.isFinite(number)) fail('invalid_arguments', `${name} must be a finite number.`);
  return number;
}

function screenPoint(target, parameters, xName, yName) {
  const bounds = target.bounds || {};
  const width = finiteNumber(bounds.width, 'target.bounds.width');
  const height = finiteNumber(bounds.height, 'target.bounds.height');
  const space = String(parameters.coordinate_space || 'window').toLowerCase();
  let x = finiteNumber(parameters[xName], xName);
  let y = finiteNumber(parameters[yName], yName);
  if (space === 'window') {
    if (x < 0 || y < 0 || x > width || y > height) fail('invalid_arguments', `${xName}/${yName} must be inside the connected window.`);
    x += finiteNumber(bounds.x, 'target.bounds.x');
    y += finiteNumber(bounds.y, 'target.bounds.y');
  } else if (space !== 'screen') {
    fail('invalid_arguments', 'coordinate_space must be window or screen.');
  }
  const left = finiteNumber(bounds.x, 'target.bounds.x');
  const top = finiteNumber(bounds.y, 'target.bounds.y');
  if (x < left || y < top || x > left + width || y > top + height) {
    fail('invalid_arguments', 'Screen point is outside the connected window bounds.');
  }
  return { x, y };
}

function cursorPoint() {
  const point = $.CGEventGetLocation($.CGEventCreate(null));
  return { x: Number(point.x), y: Number(point.y) };
}

function postMouse(type, point, button, clickState) {
  const event = $.CGEventCreateMouseEvent(null, type, point, button);
  if (!event) fail('provider_error', 'Could not create a Quartz mouse event.');
  if (clickState) $.CGEventSetIntegerValueField(event, $.kCGMouseEventClickState, clickState);
  $.CGEventPost($.kCGHIDEventTap, event);
}

function movePointer(from, to, durationMs, drag) {
  const duration = Math.max(0, Math.min(5000, Number(durationMs || 0)));
  const steps = Math.max(1, Math.min(120, Math.ceil(duration / 16)));
  for (let index = 1; index <= steps; index += 1) {
    const ratio = index / steps;
    const point = { x: from.x + ((to.x - from.x) * ratio), y: from.y + ((to.y - from.y) * ratio) };
    postMouse(drag ? $.kCGEventLeftMouseDragged : $.kCGEventMouseMoved, point, $.kCGMouseButtonLeft, 0);
    if (duration) delaySeconds(duration / steps / 1000);
  }
}

function mouseClick(point, button, count, intervalMs) {
  const right = Number(button) === Number($.kCGMouseButtonRight);
  const down = right ? $.kCGEventRightMouseDown : $.kCGEventLeftMouseDown;
  const up = right ? $.kCGEventRightMouseUp : $.kCGEventLeftMouseUp;
  postMouse($.kCGEventMouseMoved, point, button, 0);
  for (let index = 1; index <= count; index += 1) {
    postMouse(down, point, button, index);
    delaySeconds(0.025);
    postMouse(up, point, button, index);
    if (index < count) delaySeconds(Math.max(40, Math.min(500, Number(intervalMs || 100))) / 1000);
  }
}

function performCoordinateAction(target, capability, parameters) {
  let scrollEventCount = null;
  if (capability === 'click_at' || capability === 'double_click' || capability === 'right_click' || capability === 'hover_at' || capability === 'scroll_at' || capability === 'pointer_event') {
    const point = screenPoint(target, parameters, 'x', 'y');
    if (capability === 'click_at') mouseClick(point, $.kCGMouseButtonLeft, 1, 0);
    else if (capability === 'double_click') mouseClick(point, $.kCGMouseButtonLeft, 2, parameters.interval_ms);
    else if (capability === 'right_click') mouseClick(point, $.kCGMouseButtonRight, 1, 0);
    else if (capability === 'hover_at') movePointer(cursorPoint(), point, parameters.duration_ms, false);
    else if (capability === 'pointer_event') {
      const action = String(parameters.action || 'move');
      const right = String(parameters.button || 'left') === 'right';
      if (!['move', 'button_down', 'button_up'].includes(action)) fail('invalid_arguments', 'pointer_event action must be move, button_down, or button_up.');
      const button = right ? $.kCGMouseButtonRight : $.kCGMouseButtonLeft;
      const eventType = action === 'button_down'
        ? (right ? $.kCGEventRightMouseDown : $.kCGEventLeftMouseDown)
        : action === 'button_up'
          ? (right ? $.kCGEventRightMouseUp : $.kCGEventLeftMouseUp)
          : parameters.pressed === true
            ? (right ? $.kCGEventRightMouseDragged : $.kCGEventLeftMouseDragged)
            : $.kCGEventMouseMoved;
      postMouse(eventType, point, button, 0);
    }
    else {
      movePointer(cursorPoint(), point, 0, false);
      const direction = String(parameters.direction || 'down').toLowerCase();
      if (!['up', 'down', 'left', 'right'].includes(direction)) fail('invalid_arguments', 'direction must be up, down, left, or right.');
      const amount = Number(parameters.amount === undefined ? DEFAULT_SCROLL_AT_PIXEL_AMOUNT : parameters.amount);
      if (!Number.isInteger(amount) || amount < 1 || amount > MAX_SCROLL_AT_AMOUNT) {
        fail('invalid_arguments', `scroll_at amount must be an integer from 1 to ${MAX_SCROLL_AT_AMOUNT}.`);
      }
      let remaining = amount;
      scrollEventCount = 0;
      while (remaining > 0) {
        const step = Math.min(MAX_SCROLL_EVENT_AMOUNT, remaining);
        const vertical = direction === 'up' ? step : direction === 'down' ? -step : 0;
        const horizontal = direction === 'left' ? step : direction === 'right' ? -step : 0;
        const event = $.CGEventCreateScrollWheelEvent(null, $.kCGScrollEventUnitPixel, 2, vertical, horizontal);
        $.CGEventPost($.kCGHIDEventTap, event);
        remaining -= step;
        scrollEventCount += 1;
      }
    }
    const actual = cursorPoint();
    const pointerVerified = Math.abs(actual.x - point.x) <= 2 && Math.abs(actual.y - point.y) <= 2;
    const diagnostics = { method: 'Quartz CGEvent', point, actualPointer: actual, pointerVerified, foregroundRequired: true };
    if (capability === 'scroll_at') diagnostics.scrollEventCount = scrollEventCount;
    if (capability === 'pointer_event') diagnostics.inputAction = String(parameters.action || 'move');
    return { ok: true, verified: pointerVerified, uncertain: !pointerVerified, skipSnapshot: true, visualChangeExpected: capability !== 'hover_at' && capability !== 'pointer_event', summary: `Performed ${capability} at (${Math.round(point.x)}, ${Math.round(point.y)}).`, diagnostics };
  }
  let from;
  let to;
  if (capability === 'drag') {
    from = screenPoint(target, parameters, 'from_x', 'from_y');
    to = screenPoint(target, parameters, 'to_x', 'to_y');
  } else {
    from = screenPoint(target, parameters, 'x', 'y');
    const direction = String(parameters.direction || '').toLowerCase();
    if (!['up', 'down', 'left', 'right'].includes(direction)) fail('invalid_arguments', 'direction must be up, down, left, or right.');
    const distance = Math.max(1, Math.min(2000, Number(parameters.distance || 240)));
    const delta = { up: [0, -distance], down: [0, distance], left: [-distance, 0], right: [distance, 0] }[direction];
    const screenParameters = { coordinate_space: 'screen', to_x: from.x + delta[0], to_y: from.y + delta[1] };
    to = screenPoint(target, screenParameters, 'to_x', 'to_y');
  }
  movePointer(cursorPoint(), from, 0, false);
  postMouse($.kCGEventLeftMouseDown, from, $.kCGMouseButtonLeft, 1);
  movePointer(from, to, parameters.duration_ms || 350, true);
  postMouse($.kCGEventLeftMouseUp, to, $.kCGMouseButtonLeft, 1);
  const actual = cursorPoint();
  const pointerVerified = Math.abs(actual.x - to.x) <= 2 && Math.abs(actual.y - to.y) <= 2;
  return { ok: true, verified: pointerVerified, uncertain: !pointerVerified, skipSnapshot: true, visualChangeExpected: true, summary: `Performed ${capability} gesture.`, diagnostics: { method: 'Quartz CGEvent', from, to, actualPointer: actual, pointerVerified, foregroundRequired: true } };
}

function performKeySequence(resolved, parameters) {
  const steps = Array.isArray(parameters.steps) ? parameters.steps : [];
  if (!steps.length || steps.length > 64) fail('invalid_arguments', 'key_sequence requires between 1 and 64 steps.');
  for (const step of steps) {
    const type = String((step && step.type) || '').toLowerCase();
    if (type === 'shortcut') sendKeyChord(resolved.se, step.keys || []);
    else if (type === 'text') resolved.se.keystroke(String(step.text || ''));
    else if (type === 'key') sendKeyChord(resolved.se, [String(step.key || '')]);
    else if (type === 'pause') delaySeconds(Math.max(0, Math.min(5000, Number(step.ms || 0))) / 1000);
    else fail('invalid_arguments', `Unsupported key_sequence step type: ${type || '(empty)'}.`);
  }
  return { ok: true, verified: false, uncertain: true, skipSnapshot: true, visualChangeExpected: true, summary: 'Executed the atomic keyboard sequence.', diagnostics: { method: 'System Events', stepCount: steps.length, foregroundRequired: true } };
}

function performNativeAction(element, preferred) {
  const actions = safe(() => element.actions(), []);
  for (const actionName of preferred) {
    const action = actions.find((candidate) => String(safe(() => candidate.name(), '')) === actionName);
    if (action) {
      action.perform();
      return actionName;
    }
  }
  fail('unsupported_action', `Element does not support any of: ${preferred.join(', ')}.`);
}

function focusTarget(target) {
  const resolved = resolveTarget(target || {});
  resolved.proc.frontmost = true;
  safe(() => performNativeAction(resolved.win, ['AXRaise']), null);
  delaySeconds(0.06);
  const foregroundPid = Number($.NSWorkspace.sharedWorkspace.frontmostApplication.processIdentifier);
  return { ok: true, verified: foregroundPid === Number(target.pid || 0), summary: `Focused ${safe(() => resolved.proc.name(), 'application')}.`, diagnostics: { foregroundPid } };
}

function keyInfo(keys) {
  const lowered = (Array.isArray(keys) ? keys : []).map((key) => String(key).toLowerCase());
  const using = [];
  if (lowered.includes('command') || lowered.includes('meta')) using.push('command down');
  if (lowered.includes('control') || lowered.includes('ctrl')) using.push('control down');
  if (lowered.includes('option') || lowered.includes('alt')) using.push('option down');
  if (lowered.includes('shift')) using.push('shift down');
  const modifiers = new Set(['command', 'meta', 'control', 'ctrl', 'option', 'alt', 'shift']);
  const nonModifiers = lowered.filter((item) => !modifiers.has(item));
  if (nonModifiers.length !== 1) fail('invalid_arguments', 'key_chord requires exactly one non-modifier key. Use an app-native capability for multi-step text or navigation.');
  const key = nonModifiers[0];
  return { key, using };
}

function sendKeyChord(se, keys) {
  const info = keyInfo(keys);
  const keyCodes = {
    enter: 36, return: 36, tab: 48, space: 49, backspace: 51, delete: 51,
    escape: 53, esc: 53, left: 123, right: 124, down: 125, up: 126,
  };
  if (Object.prototype.hasOwnProperty.call(keyCodes, info.key)) {
    se.keyCode(keyCodes[info.key], info.using.length ? { using: info.using } : {});
  } else if (info.key) {
    se.keystroke(info.key, info.using.length ? { using: info.using } : {});
  } else {
    throw new Error('No non-modifier key was provided.');
  }
}

function perform(payload) {
  const capability = String(payload.capability || '');
  const parameters = payload.parameters || {};
  if (['browser_state', 'navigate', 'reload'].includes(capability)) {
    return performSafari(payload.target || {}, capability, parameters);
  }
  const resolved = resolveTarget(payload.target || {});
  if (['click_at', 'double_click', 'right_click', 'hover_at', 'drag', 'swipe', 'scroll_at', 'pointer_event'].includes(capability)) {
    return performCoordinateAction(payload.target || {}, capability, parameters);
  }
  if (capability === 'key_sequence') return performKeySequence(resolved, parameters);
  if (capability === 'key_chord') {
    sendKeyChord(resolved.se, parameters.keys || []);
    return { ok: true, verified: false, uncertain: true, summary: 'Sent the keyboard shortcut, but its application effect could not be verified.', diagnostics: { method: 'System Events', foregroundRequired: true } };
  }
  throw new Error(`Unsupported macOS capability: ${capability}`);
}

function dispatch(payload) {
  switch (String(payload.operation || '')) {
    case 'list_targets': return listTargets(payload);
    case 'perform': return perform(payload);
    case 'focus': return focusTarget(payload.target || {});
    default: return { ok: false, errorType: 'invalid_arguments', error: `Unknown operation: ${payload.operation}` };
  }
}

function run(argv) {
  try {
    const payload = JSON.parse(String((argv && argv[0]) || '{}'));
    return JSON.stringify(dispatch(payload));
  } catch (error) {
    return JSON.stringify({
      ok: false,
      errorType: String(error.errorType || (/not authorized|assistive|accessibility|辅助访问|-25211/i.test(String(error)) ? 'permission_required' : 'provider_error')),
      error: String((error && error.message) || error),
    });
  }
}
