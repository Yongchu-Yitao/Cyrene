{
  "name": "cyrene",
  "version": "0.9.0-beta18",
  "license": "Apache-2.0",
  "description": "Cyrene AI Agent — self-evolving AI companion",
  "desktopName": "cyrene.desktop",
  "author": {
    "name": "Cyrene",
    "email": "ikerrrrrrrrrrr@users.noreply.github.com"
  },
  "homepage": "https://github.com/ikerrrrrrrrrrr/Cyrene",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/build-app-use-macos.js",
    "start": "electron .",
    "predev": "node scripts/build-app-use-macos.js",
    "dev": "node dev-launcher.js",
    "build:app-use-macos": "node scripts/build-app-use-macos.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "build:linux": "electron-builder --linux",
    "test": "node --test */*.test.js"
  },
  "build": {
    "beforePack": "scripts/build-app-use-macos.js",
    "appId": "com.cyrene.app",
    "productName": "Cyrene",
    "electronLanguages": [
      "en",
      "zh-CN",
      "zh-TW"
    ],
    "directories": {
      "output": "../dist-electron"
    },
    "extraResources": [
      {
        "from": "../dist/Cyrene",
        "to": "python-bundle",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../dist/x64-sidecars",
        "to": "x64-sidecars",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime-tools",
        "to": "runtime-tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "../build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "../build/tray.png",
        "to": "build/tray.png"
      },
      {
        "from": "../build/tray-mac.png",
        "to": "build/tray-mac.png"
      },
      {
        "from": "../build/tray-mac@2x.png",
        "to": "build/tray-mac@2x.png"
      },
      {
        "from": "automation/app-use-macos.jxa",
        "to": "app-use/app-use-macos.jxa"
      },
      {
        "from": "automation/app-use-macos-hit-test",
        "to": "app-use/app-use-macos-hit-test"
      },
      {
        "from": "automation/app-use-windows.ps1",
        "to": "app-use/app-use-windows.ps1"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "../build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cyrene uses the microphone only when you start voice input or explicitly share it with a remote desktop session.",
        "NSScreenCaptureUsageDescription": "Cyrene shares a selected display only while an authorized Remote Desktop session is active.",
        "NSAudioCaptureUsageDescription": "Cyrene captures system audio only while an authorized Remote Desktop session is active."
      },
      "target": [
        "dmg"
      ],
      "minimumSystemVersion": "12.0",
      "artifactName": "Cyrene-${version}-mac.${ext}"
    },
    "win": {
      "icon": "../build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Cyrene-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Cyrene-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "../build/icons",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "Cyrene-${version}-x64.${ext}"
    },
    "deb": {
      "afterInstall": "scripts/linux-after-install.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "at-spi2-core",
        "freerdp3-x11 | freerdp2-x11",
        "xvfb",
        "xdotool"
      ]
    },
    "rpm": {
      "afterInstall": "scripts/linux-after-install.sh",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "xdotool"
      ]
    },
    "files": [
      "diagnostics/doctor-recovery.js",
      "diagnostics/doctor-recovery-preload.js",
      "diagnostics/doctor-recovery-renderer.js",
      "diagnostics/doctor-recovery.html",
      "main.js",
      "backend/backend-port-waiters.js",
      "backend/backend-process.js",
      "desktop/main-window-lifecycle.js",
      "shared/development-data-migration.js",
      "desktop/host-control.js",
      "browser/browser-input.js",
      "browser/browser-rpc.js",
      "browser/browser-local-preview.js",
      "browser/browser-deep-dom.js",
      "browser/browser-context-menu.js",
      "browser/browser-popup-policy.js",
      "browser/browser-target.js",
      "automation/agent-cursor.js",
      "scripts/terminal-lifecycle-soak.js",
      "shared/rotating-log.js",
      "remote-desktop/remote-desktop.js",
      "remote-desktop/remote-desktop-coordinates.js",
      "remote-desktop/remote-desktop-preload.js",
      "remote-desktop/remote-desktop-host.html",
      "remote-desktop/remote-desktop-host.js",
      "remote-desktop/remote-desktop-rdp-sidecar.js",
      "remote-desktop/remote-desktop-indicator-preload.js",
      "remote-desktop/remote-desktop-indicator.html",
      "remote-desktop/remote-desktop-indicator.css",
      "remote-desktop/remote-desktop-indicator.js",
      "remote-desktop/remote-desktop-credential-preload.js",
      "remote-desktop/remote-desktop-credential.html",
      "remote-desktop/remote-desktop-credential.js",
      "preload.js",
      "browser/browser-chat-overlay-preload.js",
      "browser/browser-tab-picker-preload.js",
      "browser/browser-tab-picker-owner.js",
      "automation/app-use.js",
      "automation/app-use-macos-worker.js",
      "automation/app-use-linux.js",
      "package.json",
      "browser/browser-sessions.js",
      "desktop/detached-panes.js",
      "desktop/desktop-settings-owner.js",
      "browser/browser-video-fullscreen.js"
    ]
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.7"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "dbus-next": "^0.10.2"
  }
}
