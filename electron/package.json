{
  "name": "cyrene",
  "version": "0.7.6",
  "license": "Apache-2.0",
  "description": "Cyrene AI Agent — self-evolving AI companion",
  "desktopName": "cyrene.desktop",
  "author": {
    "name": "Cyrene",
    "email": "ikerrrrrrrrrrr@users.noreply.github.com"
  },
  "homepage": "https://github.com/ikerrrrrrrrrrr/Cyrene",
  "main": "main.js",
  "scripts": {
    "prestart": "node build-app-use-macos.js",
    "start": "electron .",
    "predev": "node build-app-use-macos.js",
    "dev": "ELECTRON_DEV=1 electron .",
    "build:app-use-macos": "node build-app-use-macos.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "beforePack": "build-app-use-macos.js",
    "appId": "com.cyrene.app",
    "productName": "Cyrene",
    "directories": {
      "output": "../dist-electron"
    },
    "extraResources": [
      {
        "from": "../dist/Cyrene",
        "to": "python-bundle",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../dist/x64-sidecars",
        "to": "x64-sidecars",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime-tools",
        "to": "runtime-tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "../build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "../build/tray.png",
        "to": "build/tray.png"
      },
      {
        "from": "../build/tray-mac.png",
        "to": "build/tray-mac.png"
      },
      {
        "from": "../build/tray-mac@2x.png",
        "to": "build/tray-mac@2x.png"
      },
      {
        "from": "app-use-macos.jxa",
        "to": "app-use/app-use-macos.jxa"
      },
      {
        "from": "app-use-macos-hit-test",
        "to": "app-use/app-use-macos-hit-test"
      },
      {
        "from": "app-use-windows.ps1",
        "to": "app-use/app-use-windows.ps1"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "../build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cyrene uses the microphone only when you start local voice input."
      },
      "target": [
        "dmg"
      ],
      "minimumSystemVersion": "12.0",
      "artifactName": "Cyrene-${version}-mac.${ext}"
    },
    "win": {
      "icon": "../build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Cyrene-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Cyrene-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "../build/icon.png",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "Cyrene-${version}-x64.${ext}"
    },
    "deb": {
      "afterInstall": "linux-after-install.sh",
      "depends": [
        "at-spi2-core"
      ]
    },
    "rpm": {
      "afterInstall": "linux-after-install.sh"
    },
    "files": [
      "main.js",
      "host-control.js",
      "browser-input.js",
      "browser-target.js",
      "agent-cursor.js",
      "preload.js",
      "browser-chat-overlay-preload.js",
      "browser-tab-picker-preload.js",
      "app-use.js",
      "app-use-linux.js",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.7"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "dbus-next": "^0.10.2"
  }
}
