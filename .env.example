# Cyrene Environment Variables
# 
# Cyrene now uses an encrypted config store (data/config.enc) for most
# configuration. You do NOT need this file for normal operation — the
# first-run onboarding wizard handles setup through the Web UI.
# 
# This file is kept for backward compatibility. Values in the encrypted
# config store take precedence over this file.
# 
# To update settings after setup, use: Web UI > Settings > API Keys

TELEGRAM_BOT_TOKEN=
OWNER_ID=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash
ASSISTANT_NAME=Cyrene
# SCHEDULER_INTERVAL=60
