<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="ai.cyrene.mobile.permission.BIND_RUNTIME" />

    <permission
        android:name="ai.cyrene.mobile.permission.BIND_RUNTIME"
        android:protectionLevel="signature" />
    <application>
        <activity
            android:name="ai.cyrene.mobile.runtime.RuntimeBootstrapActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:permission="ai.cyrene.mobile.permission.BIND_RUNTIME"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name="ai.cyrene.mobile.runtime.CyreneRuntimeService"
            android:exported="false"
            android:permission="ai.cyrene.mobile.permission.BIND_RUNTIME"
            android:foregroundServiceType="specialUse"
            android:process=":qemu">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local Linux virtual machine running AI agent tasks and development tools" />
            <intent-filter>
                <action android:name="ai.cyrene.mobile.runtime.BIND" />
            </intent-filter>
        </service>
    </application>
</manifest>
